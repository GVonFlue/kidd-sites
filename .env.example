# NAMES ONLY. Never commit a value to this file.
# Real values live in Vercel project settings. Build Standard §14.

# Server-side only. Never expose in the client bundle.
# ProyTech holds this account, not the client. Confirmed 2026-07-27.
ANTHROPIC_API_KEY=

# Google Apps Script web-app URL. SOURCE OF TRUTH for every lead.
# Script lives in deploy/leads-apps-script.gs; deploy instructions are in its header.
# Spreadsheet: "Website Leads — Agent Kidd + Cornerstone", in the client's Drive folder.
SHEETS_WEBHOOK_URL=

# Lofty CRM. The client generates this in Lofty: Settings > Integrations > API.
# Not gated behind a plan tier.
CRM_API_KEY=
CRM_ENDPOINT_URL=

# Leave empty until GHL is live. Skipped silently when unset.
GHL_WEBHOOK_URL=

# NOT CURRENTLY READ BY ANY CODE. Canonical URLs and sitemaps are derived from
# each brand's own `domain` in src/config.
NEXT_PUBLIC_SITE_URL=

# NOT CURRENTLY READ BY ANY CODE. Reserved for the AppFolio listing feed.
APPFOLIO_API_KEY=

# TEMPORARY. Set to 1 only while the site is deployed and DNS is NOT yet pointed.
# Makes ?brand=cornerstone / ?brand=agent work on the .vercel.app URL so both
# brands can be reviewed before the domains exist. While it is on, every page is
# served noindex so the preview URL cannot be indexed.
# DELETE THIS VARIABLE the moment DNS is pointed.
ALLOW_BRAND_OVERRIDE=
